# Copy this file to .env and fill it in, then lock it down:  chmod 600 .env
# .env is git-ignored. Variables already set in your shell take priority.

# Required by repository-cloning scripts. Set GITHUB_ORG to your GitHub organization or username.
# Give GITHUB_TOKEN read-only Contents access to the configured repositories.
GITHUB_ORG=your-github-org
GITHUB_TOKEN=

# Repository names and WordPress plugin identifiers can be customized here.
A11Y_REPO_NAME=accessibility-style-fix
WORDPRESS_SCRIPTS_REPO_NAME=wordpress-scripts
WORDPRESS_SCRIPTS_PLUGIN_SLUG=wordpress-scripts
CONNECTOR_REPO_NAME=connector-plugin
CONNECTOR_PLUGIN_SLUG=connector-plugin
CONNECTOR_POST_COMMAND=set_connector_webhook_default

# Optional overrides
# APPS_ROOT=/home/master/applications
# COMPOSER_FLAGS=--no-dev --no-interaction --prefer-dist --optimize-autoloader
# LEGACY_THEMES="leadhubtheme onepageextendedtheme"
