# Copy this file to .env and fill it in, then lock it down:  chmod 600 .env
# .env is git-ignored. Variables already set in your shell take priority.

# Needed by the scripts that clone private repos (a11y fix, example connector,
# example-wordpress-scripts). Use a fine-grained personal access token with
# READ-ONLY "Contents" access to just these repositories:
#   example/accessibility-style-fix
#   example/example-Connector
#   example/example-wordpress-scripts
GITHUB_TOKEN=

# Optional overrides
# APPS_ROOT=/home/master/applications
# COMPOSER_FLAGS=--no-dev --no-interaction --prefer-dist --optimize-autoloader
# LEGACY_THEMES="leadhubtheme onepageextendedtheme"
